int main
{
    print "Fibonacci räknare";
    for(int i = 0; i <= 25; i = i+1)
    {
        print fib(i);
        print fib_recursive(i);
    }
    print "Då var det färdigt";
    return 0;
}

int fib(int n)
{
    int a = 0;
    int b = 1;
    int c;
    if (n == 0)
        return a;
    for (int i = 2; i <= n; i = i + 1) {
        c = a + b;
        a = b;
        b = c;
    }
    return b;
}

int fib_recursive(int n)
{
    if(n < 2) return n;
    return fib_recursive(n - 1) + fib_recursive(n - 2);
}